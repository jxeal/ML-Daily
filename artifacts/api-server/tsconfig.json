{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDirs": ["src", "../../lib/api-zod/src", "../../lib/db/src"],
    "types": ["node"],
    "noEmit": false,
    "declaration": false,
    "composite": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@workspace/api-zod": ["../../lib/api-zod/src/index.ts"],
      "@workspace/db": ["../../lib/db/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts", 
    "../../lib/api-zod/src/**/*.ts", 
    "../../lib/db/src/**/*.ts"
  ]
}